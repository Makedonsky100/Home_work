// case 6 по Абрамяну
#include <stdio.h>
#include <locale.h>
int main() {
	
	setlocale(LC_ALL, "");
	
	int k;
	float length; 
	float length_metres;
	
	printf("Введите число в диапазоне 1-5, ознакомившись с меню:\n\n");
	
	printf("---МЕНЮ ДЛЯ ПЕРЕВОДА В МЕТРЫ---\n");
	printf("Перевести из дециметров - нажмите 1\n");
	printf("Перевести из километров - нажмите 2\n");
	printf("Перевести из метров - нажмите 3\n");
	printf("Перевести из миллиметров - нажмите 4\n");
	printf("Перевести из сантиметров - нажмите 5\n\n");
	
	scanf("%d", &k);

  if(k < 1 || k > 5) {
      printf("ERROR! неверный пункт меню.\n");
      return 1; }
	
	printf("введите длину\n");
	scanf("%f", &length);
	switch (k){
	case 1: //переводим в метры, если длина была задана в дециметрах
		printf("длина, заданная в дециметрах: %.3f\n", length);
		length_metres = length / 10;
		break;
	case 2: //из километров в метры
		printf("длина, заданная в километрах: %.3f\n", length);
		length_metres = length * 1000;
		break;
	case 3: 
		printf("длина, заданная в метрах: %.3f\n", length);
		length_metres = length; //из метра в метры
		break;
	case 4:
		printf("длина, заданная в миллиметрах: %.3f\n", length);
		length_metres = length / 1000; //из миллиметров в метры
		break;
	case 5:
		printf("длина, заданная в сантиметрах: %.3f\n", length);
		length_metres = length / 100; //из сантиметров в метры 
		break;
	}
	
	printf("длина, переведенная в метры: %.3f\n", length_metres);
	return 0;
}
